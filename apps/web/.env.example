# Copy to .env.local for local development. Both values are inlined into the
# browser bundle at build time, so they are public by definition -- never put a
# secret behind a NEXT_PUBLIC_ name.

# Where the browser reaches the FastAPI service. This is resolved in the
# visitor's browser, so it must be an address the browser can reach: even when
# the API runs in Docker as the service `api`, this stays localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Mirrors PICKLEBALL_MAX_UPLOAD_BYTES on the API, for the client-side check.
# The server enforces the real limit; this only avoids a pointless upload.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=2147483648
