# Copy to .env and adjust. .env is gitignored; never put a real credential in
# this file, which is tracked.
#
# Every name is prefixed PICKLEBALL_ (see
# apps/api/src/pickleball_api/config.py). The API and the worker share all of
# these except CORS_ORIGINS and TRUSTED_HOSTS, which only the API serves.

# development | test | production
PICKLEBALL_ENVIRONMENT=development

# Matches the docker-compose postgres service, which publishes 5433 so it does
# not collide with a PostgreSQL already installed on the machine.
PICKLEBALL_DATABASE_URL=postgresql+psycopg://pickleball:pickleball@localhost:5433/pickleball
# Logs every statement, with its parameter values. Leave false outside debugging.
PICKLEBALL_DATABASE_ECHO=false

PICKLEBALL_REDIS_URL=redis://localhost:6379/0
PICKLEBALL_QUEUE_NAME=analysis
PICKLEBALL_JOB_TIMEOUT_SECONDS=3600

# Where uploaded video is written. Gitignored; never inside the package.
PICKLEBALL_UPLOAD_DIR=data/uploads
# 2 GiB. A full match at 1080p60 can exceed this; raise it deliberately.
PICKLEBALL_MAX_UPLOAD_BYTES=2147483648
# JSON lists. Each extension needs an entry in VIDEO_CONTENT_TYPES.
PICKLEBALL_ALLOWED_VIDEO_EXTENSIONS=[".mp4",".mov",".m4v"]

# The Next.js dev server, for Phase 1 checkpoint 2.
PICKLEBALL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PICKLEBALL_TRUSTED_HOSTS=["localhost","127.0.0.1"]
